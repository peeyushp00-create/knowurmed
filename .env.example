# Optional. Copy this file to .env to change any setting; without a .env the
# app runs locally with SQLite and debug mode on.
# .env is gitignored and must never be committed.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database: SQLite by default. To use MySQL, set DB_ENGINE=mysql, fill in the
# values below and `pip install mysqlclient`.
# DB_ENGINE=mysql
# DB_NAME=knowurmed
# DB_USER=root
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=3306

# OCR (optional). Only needed if Tesseract isn't on PATH, or for PDF uploads
# when Poppler isn't on PATH. Without Tesseract, patients add medicines by hand.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=
