# Copy this file to .env and fill in real values for your environment.
# .env is gitignored and must never be committed.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set to any non-empty value to use SQLite for local development instead of MySQL.
USE_SQLITE=1

# MySQL (used when USE_SQLITE is unset)
DB_NAME=knowurmed
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# OCR (Phase 2 — prescription upload). Point these at your local Tesseract/Poppler
# installs if they aren't on PATH. Leave POPPLER_PATH empty if pdftoppm is on PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=
